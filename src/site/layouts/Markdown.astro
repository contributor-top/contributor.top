---
import Base from "./Base.astro";

type Props = { frontmatter: { title: string; description?: string } };
const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} {...frontmatter.description ? { description: frontmatter.description } : {}}>
  <article>
    <slot />
  </article>
</Base>

<style>
  article {
    overflow-wrap: break-word;
  }
  article :global(h1) {
    margin-top: 0;
  }
  article :global(h2) {
    margin-top: 32px;
    font-size: 20px;
  }
  article :global(code) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0 4px;
    font-size: 0.92em;
  }
</style>
