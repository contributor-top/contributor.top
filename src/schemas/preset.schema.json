{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "allOf": [
        {
          "pattern": "^[\\p{L}\\p{M}\\p{N} ,.'’()-]+$"
        },
        {
          "pattern": "[\\p{L}\\p{N}]"
        }
      ]
    },
    "iso": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "include": {
      "minItems": 1,
      "maxItems": 150,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64
      }
    },
    "exclude": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64
      }
    },
    "post_filter": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    }
  },
  "required": [
    "title",
    "iso",
    "include",
    "exclude"
  ],
  "additionalProperties": false
}
