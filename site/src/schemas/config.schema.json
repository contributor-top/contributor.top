{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "site": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false
    },
    "ranking": {
      "type": "object",
      "properties": {
        "top_n": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "top_choices": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "default_top": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "consider": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "world_top_n": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "private_flag_share": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "required": [
        "top_n",
        "top_choices",
        "default_top",
        "consider",
        "world_top_n",
        "private_flag_share"
      ],
      "additionalProperties": false
    },
    "collector": {
      "type": "object",
      "properties": {
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "parallel_countries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "pause_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_skipped_per_country": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "budget_floor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "required": [
        "batch_size",
        "parallel_countries",
        "pause_ms",
        "max_skipped_per_country",
        "budget_floor"
      ],
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "properties": {
        "target_hours": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "min_refresh_hours": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_run_minutes": {
          "type": "integer",
          "minimum": 10,
          "maximum": 350
        },
        "stale_days": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "target_hours",
        "min_refresh_hours",
        "max_run_minutes",
        "stale_days"
      ],
      "additionalProperties": false
    },
    "circuit_breaker": {
      "type": "object",
      "properties": {
        "max_candidate_drop": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "max_top_change": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "max_threshold_jump": {
          "type": "number",
          "exclusiveMinimum": 1
        }
      },
      "required": [
        "max_candidate_drop",
        "max_top_change",
        "max_threshold_jump"
      ],
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "optout_phrase": {
          "type": "string",
          "minLength": 5,
          "maxLength": 60
        },
        "optin_phrase": {
          "type": "string",
          "minLength": 5,
          "maxLength": 60
        },
        "dropped_stub_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "optout_phrase",
        "optin_phrase",
        "dropped_stub_days"
      ],
      "additionalProperties": false
    },
    "denylist_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "reserved_slugs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "site",
    "ranking",
    "collector",
    "freshness",
    "circuit_breaker",
    "privacy",
    "denylist_ids",
    "reserved_slugs"
  ],
  "additionalProperties": false
}
