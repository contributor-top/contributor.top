---
import { i18n } from "../i18n/index.ts";
import { config } from "../lib/site.ts";

// Small "Star · N" link, rendered at once so nothing moves when the count arrives: the count comes from
// the GitHub API in the browser (cached for the session) into a slot whose width is reserved.
const repo = config.site.repo;
const { t } = i18n(Astro.currentLocale);
---

<a class="stars" href={`https://github.com/${repo}`} data-repo={repo} aria-label={t("stars.aria")}>
  {/* The star spans y 0.25–14.4 of its 16×16 box: the box starts 0.67 higher, so the star sits at its middle. */}
  <svg viewBox="0 -0.67 16 16" width="14" height="14" aria-hidden="true">
    <path
      fill="currentColor"
      d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
    ></path>
  </svg>
  <span class="label">{t("stars.label")}</span>
  <span class="count"></span>
</a>

<script>
  // On every page load: a sidebar in another language comes with its own link. Each link is filled in once.
  document.addEventListener("astro:page-load", () => {
    const link = document.querySelector<HTMLAnchorElement>("a.stars");
    const repo = link?.dataset["repo"];
    if (!link || link.dataset["ready"] || !repo || !/^[A-Za-z0-9-]+\/[A-Za-z0-9._-]+$/.test(repo)) return;
    link.dataset["ready"] = "true";
    const key = `stars:${repo}`;
    const show = (n: number) => {
      const count = link.querySelector(".count");
      if (count) count.textContent = n.toLocaleString(document.documentElement.lang);
    };
    let cached: string | null = null;
    try {
      cached = sessionStorage.getItem(key);
    } catch {}
    if (cached !== null) {
      if (/^\d+$/.test(cached)) show(Number(cached));
    } else {
      fetch(`https://api.github.com/repos/${repo}`)
        .then((res) => (res.ok ? res.json() : null))
        .then((body: { stargazers_count?: unknown } | null) => {
          const stars = typeof body?.stargazers_count === "number" ? body.stargazers_count : null;
          try {
            sessionStorage.setItem(key, stars === null ? "" : String(stars));
          } catch {}
          if (stars !== null) show(stars);
        })
        .catch(() => {});
    }
  });
</script>

<style>
  .stars {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
  }
  .stars:hover {
    color: var(--fg);
    text-decoration: none;
  }
  /* Reserved before the number arrives (and kept if it never does), so the header never shifts. */
  .count {
    min-width: 3ch;
    min-height: 18px;
    box-sizing: border-box;
    text-align: center;
    padding: 0 6px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .count:empty {
    visibility: hidden;
  }
  /* Phones: the star and the number only, next to the theme switch. */
  @media (max-width: 860px) {
    .label {
      display: none;
    }
  }
</style>
