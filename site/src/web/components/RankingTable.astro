---
import type { CountryData, Row } from "../../collector/country-data.ts";
import type { Tab } from "../../collector/rank.ts";
import { DEFAULT_LANG, i18n, type Key } from "../i18n/index.ts";
import { inlineScript } from "../lib/inline.ts";
import { chunkStarts, countryByTitle, FIRST_ROWS, sizesFor } from "../lib/site.ts";
import rankingSource from "../scripts/ranking.js?raw";
import RankingRows from "./RankingRows.astro";

type Props = {
  rows: (Row & { country?: string })[];
  breakdown?: CountryData["breakdown"];
  tab?: Tab;
  /** rowsBase() of this ranking: its rows after the first FIRST_ROWS, a fragment per step (pages/rows). */
  more: string;
};
const { rows, breakdown, tab = "public", more } = Astro.props;
const { choices, defaultTop } = sizesFor(rows.length);
const starts = chunkStarts(rows.length);
const { lang, locale, t, forms, country } = i18n(Astro.currentLocale);
// Rows loaded later come in English (one fragment for every language): ranking.js puts them into this language.
const ROW_MESSAGES: Key[] = [
  "row.commits",
  "row.prs",
  "row.issues",
  "row.reviews",
  "row.private",
  "row.privateShare",
  "row.automated",
];
const words =
  lang === DEFAULT_LANG
    ? undefined
    : JSON.stringify({
        locale,
        messages: Object.fromEntries(ROW_MESSAGES.map((key) => [key, forms(key)])),
        // The world ranking names each person's country.
        countries: Object.fromEntries(
          [...new Set(rows.flatMap((r) => (r.country ? [r.country] : [])))].map((title) => [
            title,
            country(countryByTitle(title)),
          ]),
        ),
      });
---

<div class="toolbar needs-js">
  <span class="muted">{t("table.showTop")}</span>
  <div class="segmented" role="group" aria-label={t("table.sizes")} data-top-switch>
    {choices.map((c) => <button type="button" data-top-value={c} data-label={c}>{c}</button>)}
  </div>
</div>

<table
  class="ranking"
  data-top={defaultTop}
  data-choices={choices.join(",")}
  data-more={starts.length > 0 ? more : undefined}
  data-starts={starts.join(",")}
  data-count={rows.length}
  data-i18n={words}
>
  <thead>
    <tr>
      <th scope="col" class="r">#</th><th scope="col">{t("table.developer")}</th><th scope="col" class="c">
        {t("table.contributions")}
      </th>
    </tr>
  </thead>
  <tbody>
    <RankingRows rows={rows.slice(0, FIRST_ROWS)} breakdown={breakdown} tab={tab} eager />
  </tbody>
</table>
{
  starts.length > 0 && (
    <noscript>
      <p class="muted">{t("table.noscript", { first: FIRST_ROWS, n: rows.length })}</p>
    </noscript>
  )
}

{/* Before the first paint: marks and scrolls to a linked row. Its CSP hash is in astro.config.mjs. */}
<script is:inline data-astro-rerun set:html={inlineScript("ranking", rankingSource)} />

<style is:global>
  /* Global, but every selector starts at the toolbar or the ranking table: Astro's scoped styles would put a
     data-astro-cid attribute on each of the table's thousands of elements. */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
  }
  table.ranking {
    width: 100%;
    border-collapse: collapse;
  }
  .ranking th {
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
  }
  .ranking td {
    padding: 8px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }
  /* Column widths must not depend on rows that arrive after the first paint (ranking.js), or the table shifts
     sideways when they do: the rank column fits three digits from the start, the contributions column is only as
     wide as its content, and the developer column takes the rest (instead of a share set by the longest logins). */
  .ranking .r {
    width: 56px;
    text-align: right;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .ranking .c {
    width: 1%;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .ranking td.c {
    font-weight: 600;
    white-space: nowrap;
  }
  .ranking .gold,
  .ranking .silver,
  .ranking .bronze {
    font-weight: 700;
  }
  .ranking .gold {
    color: var(--gold);
  }
  .ranking .silver {
    color: var(--silver);
  }
  .ranking .bronze {
    color: var(--bronze);
  }
  /* A light tint for the top 3, just enough to stand out. */
  .ranking .gold-row {
    background: var(--gold-bg);
  }
  .ranking .silver-row {
    background: var(--silver-bg);
  }
  .ranking .bronze-row {
    background: var(--bronze-bg);
  }
  /* Where a #login link puts its row: about the middle of the screen. The browser's own jump to the anchor and
     the script's scrollIntoView (block: start) both use this, so the page lands once instead of jumping twice. */
  .ranking tbody tr {
    scroll-margin-top: calc(50vh - 30px);
  }
  /* The row a badge link opens: a quiet tint with a thin edge, so it stays findable after scrolling without
     shouting. :target covers pages without JS. */
  .ranking tr:target,
  .ranking tr.is-target {
    background: var(--highlight);
  }
  .ranking tr:target > td:first-child,
  .ranking tr.is-target > td:first-child {
    box-shadow: inset 3px 0 0 var(--highlight-edge);
  }
  /* Logins use their own token: blue in the light theme, plain text in the dark one; hover only underlines. */
  .ranking .who a {
    color: var(--login);
  }
  /* The login, then (world ranking) the country, on one line. The line takes the width the column has and never
     sets it (contain), so nothing in it can widen the table past a phone's screen. On phones the login has the
     first line to itself and the country goes under it. */
  .ranking .who > div {
    flex: 1;
    min-width: 0;
  }
  .ranking .line {
    display: flex;
    align-items: baseline;
    gap: 0 6px;
    min-width: 0;
    contain: inline-size;
  }
  .ranking .line > * {
    flex-shrink: 0;
  }
  /* The separator comes from here, so it shows only between two things. */
  .ranking .line > .country::before {
    content: "· ";
  }
  .ranking .who {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ranking .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  /* Same quiet style as the stats: an informational hint, not a warning. */
  .ranking .flag {
    color: var(--muted);
    font-weight: 400;
    margin-right: 6px;
  }
  .ranking .stats [data-tip]:hover,
  .ranking .flag:hover {
    color: var(--fg);
  }
  .ranking img,
  .ranking .avatar-placeholder {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    flex: none;
  }
  /* A quiet circle holds the avatar's place until the photo arrives, then the photo covers it. */
  .ranking img {
    background: var(--skeleton);
  }
  .ranking .avatar-placeholder {
    display: inline-grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .ranking th,
    .ranking td {
      padding: 6px 4px;
    }
    .ranking .r {
      width: calc(3ch + 8px); /* ranks up to 512, plus the padding */
    }
    .ranking .who {
      gap: 8px;
    }
    .ranking .who a {
      overflow-wrap: anywhere;
    }
    /* The login on a line of its own (a very long one may wrap), the country under it. */
    .ranking .line {
      flex-wrap: wrap;
    }
    .ranking .line > a {
      flex: 1 1 100%;
    }
    .ranking .line > a + .country::before {
      content: none;
    }
    .ranking img,
    .ranking .avatar-placeholder {
      width: 24px;
      height: 24px;
    }
  }
</style>
