---
import type { CountryData, Row } from "../../collector/country-data.ts";
import type { Tab } from "../../collector/rank.ts";
import { chunkStarts, FIRST_ROWS, sizesFor } from "../lib/site.ts";
import ranking from "../scripts/ranking.js?raw";
import RankingRows from "./RankingRows.astro";

type Props = {
  rows: (Row & { country?: string })[];
  breakdown?: CountryData["breakdown"];
  names?: CountryData["names"];
  tab?: Tab;
  /** rowsBase() of this ranking: its rows after the first FIRST_ROWS, a fragment per step (pages/rows). */
  more: string;
};
const { rows, breakdown, names, tab = "public", more } = Astro.props;
const { choices, defaultTop } = sizesFor(rows.length);
const starts = chunkStarts(rows.length);
---

<div class="toolbar needs-js">
  <span class="muted">Show top</span>
  <div class="segmented" role="group" aria-label="Number of people shown" data-top-switch>
    {choices.map((c) => <button type="button" data-top-value={c} data-label={c}>{c}</button>)}
  </div>
</div>

<table
  class="ranking"
  data-top={defaultTop}
  data-choices={choices.join(",")}
  data-more={starts.length > 0 ? more : undefined}
  data-starts={starts.join(",")}
  data-count={rows.length}
>
  <thead>
    <tr><th scope="col" class="r">#</th><th scope="col">Developer</th><th scope="col" class="c">Contributions</th></tr>
  </thead>
  <tbody>
    <RankingRows rows={rows.slice(0, FIRST_ROWS)} breakdown={breakdown} names={names} tab={tab} />
  </tbody>
</table>
{
  starts.length > 0 && (
    <noscript>
      <p class="muted">The top {FIRST_ROWS} of {rows.length} are shown; the rest need JavaScript.</p>
    </noscript>
  )
}

{/* Before the first paint: marks and scrolls to a linked row. Its CSP hash is in astro.config.mjs. */}
<script is:inline data-astro-rerun set:html={ranking} />

<style is:global>
  /* Global, but every selector starts at the toolbar or the ranking table: Astro's scoped styles would put a
     data-astro-cid attribute on each of the table's thousands of elements. */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
  }
  table.ranking {
    width: 100%;
    border-collapse: collapse;
  }
  .ranking th {
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
  }
  .ranking td {
    padding: 8px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }
  /* Column widths must not depend on rows that arrive after the first paint (ranking.js), or the table shifts
     sideways when they do: the rank column fits three digits from the start, the contributions column is only as
     wide as its content, and the developer column takes the rest (instead of a share set by the longest names). */
  .ranking .r {
    width: 56px;
    text-align: right;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .ranking .c {
    width: 1%;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .ranking td.c {
    font-weight: 600;
    white-space: nowrap;
  }
  .ranking .gold,
  .ranking .silver,
  .ranking .bronze {
    font-weight: 700;
  }
  .ranking .gold {
    color: var(--gold);
  }
  .ranking .silver {
    color: var(--silver);
  }
  .ranking .bronze {
    color: var(--bronze);
  }
  /* A light tint for the top 3, just enough to stand out. */
  .ranking .gold-row {
    background: var(--gold-bg);
  }
  .ranking .silver-row {
    background: var(--silver-bg);
  }
  .ranking .bronze-row {
    background: var(--bronze-bg);
  }
  /* Where a #login link puts its row: about the middle of the screen. The browser's own jump to the anchor and
     the script's scrollIntoView (block: start) both use this, so the page lands once instead of jumping twice. */
  .ranking tbody tr {
    scroll-margin-top: calc(50vh - 30px);
  }
  /* The row a badge link opens: a quiet tint with a thin edge, so it stays findable after scrolling without
     shouting. :target covers pages without JS. */
  .ranking tr:target,
  .ranking tr.is-target {
    background: var(--highlight);
  }
  .ranking tr:target > td:first-child,
  .ranking tr.is-target > td:first-child {
    box-shadow: inset 3px 0 0 var(--highlight-edge);
  }
  /* Logins use their own token: blue in the light theme, plain text in the dark one; hover only underlines. */
  .ranking .who a {
    color: var(--login);
  }
  /* Login, then the display name (shortened first when the row is narrow), then the country. The line takes the
     width the column has and never sets it (contain): a long name, cut with an ellipsis anyway, would otherwise widen
     the table past a phone's screen. */
  .ranking .who > div {
    flex: 1;
    min-width: 0;
  }
  .ranking .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 6px;
    min-width: 0;
    contain: inline-size;
  }
  .ranking .line > * {
    flex-shrink: 0;
  }
  /* The name takes what the login leaves, up to its own width, cut with an ellipsis; where fewer than about five
     letters would fit, it moves under the login instead of shrinking to a sliver. */
  .ranking .line > .name {
    flex: 1 1 5em;
    max-width: max-content;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
    font-size: 13px;
  }
  .ranking .who {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ranking .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  /* Same quiet style as the stats: an informational hint, not a warning. */
  .ranking .flag {
    color: var(--muted);
    font-weight: 400;
    margin-right: 6px;
  }
  .ranking .stats [data-tip]:hover,
  .ranking .flag:hover {
    color: var(--fg);
  }
  .ranking img,
  .ranking .avatar-placeholder {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    flex: none;
  }
  /* A quiet circle holds the avatar's place until the photo arrives, then the photo covers it. */
  .ranking img {
    background: var(--skeleton);
  }
  .ranking .avatar-placeholder {
    display: inline-grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .ranking th,
    .ranking td {
      padding: 6px 4px;
    }
    .ranking .r {
      width: calc(3ch + 8px); /* ranks up to 512, plus the padding */
    }
    .ranking .who {
      gap: 8px;
    }
    .ranking .who a {
      overflow-wrap: anywhere;
    }
    /* A very long login may wrap here rather than push the row wider than the screen. */
    .ranking .line > a {
      flex-shrink: 1;
    }
    .ranking img,
    .ranking .avatar-placeholder {
      width: 24px;
      height: 24px;
    }
  }
</style>
