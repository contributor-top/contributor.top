---
// Rows of a ranking: on the page (the first ones, in the page's language) and in the /rows/… fragments (the rest,
// loaded when asked for, built once in English for every language). Every number and tooltip carries data-n (the
// number) and data-k (its message), so ranking.js can put an inserted fragment into the page's language.
import type { CountryData, Row } from "../../collector/country-data.ts";
import { compactNumber, isLikelyAutomated, isMostlyPrivate, privateShare } from "../../collector/flags.ts";
import type { Tab } from "../../collector/rank.ts";
import { i18n } from "../i18n/index.ts";
import { config, countryByTitle } from "../lib/site.ts";
import BotIcon from "./BotIcon.astro";
import LockIcon from "./LockIcon.astro";

type Props = {
  rows: (Row & { country?: string })[];
  breakdown?: CountryData["breakdown"] | undefined;
  tab?: Tab;
};
const { rows, breakdown, tab = "public" } = Astro.props;

const { t, number, country } = i18n(Astro.currentLocale);
/** Compact always-visible breakdown: label, value, the message of its tooltip. */
const stats = (b: CountryData["breakdown"][string]) =>
  [
    ["C", b.commits, "row.commits"],
    ["PR", b.prs, "row.prs"],
    ["IS", b.issues, "row.issues"],
    ["RV", b.reviews, "row.reviews"],
    ["private", b.private, "row.private"],
  ] as const;
const publicOf = (b: CountryData["breakdown"][string]) => b.commits + b.prs + b.issues + b.reviews;
const medal = (rank: number) => (rank === 1 ? "gold" : rank === 2 ? "silver" : rank === 3 ? "bronze" : "");
---

{
  rows.map((row) => {
    const b = breakdown?.[String(row.id)];
    const flagged =
      tab === "all" && b !== undefined && isMostlyPrivate(publicOf(b), b.private, config.ranking.private_flag_share);
    const share = flagged ? Math.round(privateShare(publicOf(b), b.private) * 100) : 0;
    // Commit farms stay in country rankings, marked; the world ranking leaves them out.
    const automated = b !== undefined && isLikelyAutomated(b, config.ranking.automated);
    return (
      <tr id={row.login.toLowerCase()} data-rank={row.rank} class={medal(row.rank) ? `podium ${medal(row.rank)}-row` : undefined}>
        <td class={`r ${medal(row.rank)}`}>{row.rank}</td>
        <td>
          <div class="who">
            {row.id > 0 ? (
              <img loading="lazy" width="28" height="28" alt="" src={`https://avatars.githubusercontent.com/u/${row.id}?s=56`} />
            ) : (
              <span class="avatar-placeholder" aria-hidden="true">{row.login.slice(0, 1).toUpperCase()}</span>
            )}
            <div>
              <div class="line">
                <a href={`https://github.com/${row.login}`}>{row.login}</a>
                {row.country && <span class="country muted">{country(countryByTitle(row.country))}</span>}
              </div>
              {b && (
                <div class="stats">
                  {stats(b).map(([label, value, key]) => (
                    <span tabindex="0" data-tip data-k={key} data-n={value} aria-label={t(key, { n: value })}>
                      {label === "private" ? <LockIcon /> : label} {compactNumber(value)}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </td>
        <td class="c">
          {automated && (
            <span class="flag tip-end" tabindex="0" data-tip data-k="row.automated" aria-label={t("row.automated")} role="img">
              <BotIcon />
            </span>
          )}
          {flagged && (
            <span
              class="flag tip-end"
              tabindex="0"
              data-tip
              data-k="row.privateShare"
              data-n={share}
              aria-label={t("row.privateShare", { n: share })}
              role="img"
            >
              <LockIcon />
            </span>
          )}
          <span data-n={row.contributions}>{number(row.contributions)}</span>
        </td>
      </tr>
    );
  })
}
