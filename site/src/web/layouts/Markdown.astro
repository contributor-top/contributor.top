---
// Methodology and Privacy: the page's Markdown in this language (i18n/docs/<language>/<doc>.md), English where a
// translation is missing. A translation says that the English text applies and where to report a mistake.
import { getEntry, render } from "astro:content";
import RuleNumbers from "../components/RuleNumbers.astro";
import { DEFAULT_LANG, i18n, parts, prefixOf } from "../i18n/index.ts";
import { config } from "../lib/site.ts";
import Base from "./Base.astro";

type Props = { doc: "methodology" | "privacy" };
const { doc } = Astro.props;
const { lang, t } = i18n(Astro.currentLocale);
const entry = (await getEntry("docs", `${lang}/${doc}`)) ?? (await getEntry("docs", `${DEFAULT_LANG}/${doc}`));
if (!entry) throw new Error(`docs: no ${DEFAULT_LANG}/${doc}.md`);
const { Content } = await render(entry);
const translated = lang !== DEFAULT_LANG && entry.id === `${lang}/${doc}`;
// The announcement appears only on these text pages, not over the rankings; an empty message hides it.
const notice = t("site.notice");
const english = `${prefixOf(DEFAULT_LANG)}/${doc}/`;
const report = `https://github.com/${config.site.repo}/issues/new?template=translation.yml`;
---

<Base title={entry.data.title} description={entry.data.description}>
  {
    notice && (
      <p class="notice muted">
        {/* Split on [brackets]: every odd part was inside them. */}
        {notice.split(/\[([^\]]*)\]/).map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}
      </p>
    )
  }
  <article>
    <RuleNumbers><Content /></RuleNumbers>
  </article>
  {
    translated && (
      <p class="translated muted">
        {parts(t("doc.translated")).map((part) =>
          part === "{english}" ? (
            <a href={english}>{t("doc.english")}</a>
          ) : part === "{report}" ? (
            <a href={report}>{t("doc.report")}</a>
          ) : (
            part
          ),
        )}
      </p>
    )
  }
</Base>

<style>
  .translated {
    margin: 32px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 12px;
  }
  .notice {
    margin: 0 0 16px;
    font-size: 12px;
  }
  .notice strong {
    color: var(--accent);
  }
  article {
    overflow-wrap: break-word;
  }
  article :global(h1) {
    margin-top: 0;
  }
  article :global(h2) {
    margin-top: 32px;
    font-size: 20px;
  }
  article :global(code) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0 4px;
    font-size: 0.92em;
  }
  /* The rules table of Methodology: read row by row, so rows are ruled and cells start at the top. */
  article :global(table) {
    width: 100%;
    margin: 16px 0;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.45;
  }
  article :global(:is(th, td)) {
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  article :global(th) {
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
  }
  article :global(td:first-child) {
    font-weight: 600;
  }
  @media (max-width: 560px) {
    article :global(table) {
      font-size: 13px;
    }
    article :global(:is(th, td)) {
      padding: 6px 6px 6px 0;
    }
  }
</style>
