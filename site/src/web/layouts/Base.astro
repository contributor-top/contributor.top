---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { jsonForScript } from "../../collector/safe-json.ts";
import RepoCard from "../components/RepoCard.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { config } from "../lib/site.ts";
import themeInit from "../scripts/theme-init.js?raw";

type Props = {
  title: string;
  description?: string;
  /** Thin or utility pages (404, a country still collecting data) stay out of search results. */
  noindex?: boolean;
  /** schema.org structured data for this page. */
  jsonLd?: Record<string, unknown>;
};
const {
  title,
  description = "The most active GitHub users in every country, ranked by public contributions over the last 12 months.",
  noindex = false,
  jsonLd,
} = Astro.props;
const fullTitle = title === "contributor.top" ? title : `${title} | contributor.top`;
// Canonical URL: always the clean path (no ?top=…), with the trailing slash the site uses.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const nav = [
  ["Countries", "/"],
  ["World", "/world/"],
  ["Get a badge", "/badge/"],
  ["Methodology", "/methodology/"],
  ["Privacy", "/privacy/"],
] as const;
const current = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? current === "/" : current.startsWith(href));
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="contributor.top" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {jsonLd && <script type="application/ld+json" set:html={jsonForScript(jsonLd)} />}
    {/* Runs before paint: saved theme (light by default) and the "js" class. Its CSP hash is in astro.config.mjs. */}
    <script is:inline set:html={themeInit} />
    {/* Links load the next page in the background and swap it in: no reload, no blank flash, no animation
        (fallback="swap" also in browsers without the View Transitions API, such as Firefox). */}
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="layout">
      <aside transition:persist="sidebar">
        <div class="brand">
          <a class="logo" href="/">contributor<span>.top</span></a>
          <p class="tagline muted">The most active GitHub users by country</p>
        </div>
        <nav aria-label="Main">
          {nav.map(([label, href]) => <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>)}
        </nav>
        <div class="tools">
          <RepoCard />
          <ThemeToggle />
        </div>
        <p class="about muted">
          Data from public GitHub profiles. <a href={`https://github.com/${config.site.repo}`}>Source on GitHub</a>.
        </p>
      </aside>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  // The sidebar is not re-rendered on navigation, so the current page is marked here.
  document.addEventListener("astro:page-load", () => {
    const here = location.pathname;
    for (const link of document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Main"] a')) {
      const path = link.pathname;
      const current = path === "/" ? here === "/" : here.startsWith(path);
      if (current) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    }
  });
</script>

<style>
  /* Fixed column widths: every page has the same geometry, so nothing jumps when navigating. */
  .layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 760px);
    justify-content: center;
    gap: 56px;
    padding: 40px 24px;
  }
  /* The sidebar stays in view while the ranking scrolls. */
  aside {
    position: sticky;
    top: 40px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: calc(100dvh - 80px);
    overflow-y: auto;
  }
  .logo {
    font-size: 24px;
    font-weight: 700;
    color: var(--fg);
    line-height: 1.1;
  }
  .logo span {
    color: var(--accent);
  }
  .tagline {
    margin: 6px 0 0;
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  nav a {
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--fg);
  }
  nav a[aria-current="page"] {
    font-weight: 600;
  }
  .tools {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .about {
    margin: auto 0 0;
    font-size: 12px;
  }
  main {
    min-width: 0;
  }

  /* Phones and narrow windows: a compact header above the content. */
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding: 16px;
    }
    aside {
      position: static;
      height: auto;
      overflow: visible;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 12px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--line);
    }
    .tagline {
      display: none;
    }
    .tools {
      grid-column: 2;
      grid-row: 1;
      flex-direction: row;
      align-items: center;
      gap: 14px;
    }
    nav {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px 16px;
    }
    .about {
      display: none;
    }
  }
</style>
