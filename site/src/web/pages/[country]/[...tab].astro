---
import type { GetStaticPaths } from "astro";
import type { Tab } from "../../../collector/rank.ts";
import RankingHead from "../../components/RankingHead.astro";
import RankingTable from "../../components/RankingTable.astro";
import { i18n, parts } from "../../i18n/index.ts";
import Base from "../../layouts/Base.astro";
import { type CountryEntry, config, countryEntries, rowsBase, TAB_PATHS, TABS, tabHref } from "../../lib/site.ts";

export const getStaticPaths = (() =>
  countryEntries.flatMap((entry) =>
    TABS.filter((tab) => entry.data || tab === "public").map((tab) => ({
      params: { country: entry.slug, tab: TAB_PATHS[tab] || undefined },
      props: { entry, tab },
    })),
  )) satisfies GetStaticPaths;

type Props = { entry: CountryEntry; tab: Tab };
const { entry, tab } = Astro.props;
const { t, href, dateTime, country: nameOf } = i18n(Astro.currentLocale);
const data = entry.data;
const country = nameOf(entry);

const what = t(`country.what.${tab}`);
const title = tab === "public" ? t("country.title", { country }) : t("country.titleBy", { country, what });
const top3 = data?.tabs[tab].slice(0, 3).map((r) => r.login) ?? [];
const description = data
  ? t("country.description", {
      n: data.tabs[tab].length,
      country,
      what,
      top: top3.length ? t("country.top", { logins: top3.join(", ") }) : "",
      date: dateTime(data.updatedAt),
    })
  : t("country.collectingDescription", { country });
const url = new URL(href(tabHref(entry.slug, tab)), Astro.site).href;
const more = rowsBase(`${entry.slug}/${tab}`);
// Dataset helps Google Dataset Search; ItemList and breadcrumbs describe the page itself.
const jsonLd = data
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Dataset",
          name: title,
          description,
          url,
          dateModified: data.updatedAt,
          license: "https://opensource.org/license/mit",
          isAccessibleForFree: true,
          spatialCoverage: { "@type": "Place", name: country },
          creator: { "@type": "Organization", name: "contributor.top", url: Astro.site?.href },
        },
        {
          "@type": "ItemList",
          name: title,
          numberOfItems: data.tabs[tab].length,
          itemListElement: data.tabs[tab].slice(0, 10).map((r) => ({
            "@type": "ListItem",
            position: r.rank,
            url: `https://github.com/${r.login}`,
            name: r.login,
          })),
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: t("nav.countries"), item: new URL(href("/"), Astro.site).href },
            { "@type": "ListItem", position: 2, name: country, item: url },
          ],
        },
      ],
    }
  : undefined;
---

<Base title={title} description={description} noindex={!data} jsonLd={jsonLd}>
  <RankingHead slot="head" count={data?.tabs[tab].length ?? 0} more={more} />
  <h1>{country}</h1>
  {
    data ? (
      <>
        <p class="muted meta">
          <span>
            {
              parts(t("country.updated")).map((part) =>
                part === "{date}" ? <time datetime={data.updatedAt}>{dateTime(data.updatedAt)}</time> : part,
              )
            }
          </span>
          <span>{t("country.users", { n: data.totalUsers })}</span>
          <span>{t("country.considered", { n: data.considered, min: data.minFollowers })}</span>
        </p>
        <nav class="tabs" aria-label={t("country.tabs")}>
          {TABS.map((key) => (
            <a href={href(tabHref(entry.slug, key))} aria-current={key === tab ? "page" : undefined}>
              <span class="long">{t(`tab.${key}`)}</span>
              <span class="short" aria-hidden="true">
                {t(`tab.${key}.short`)}
              </span>
            </a>
          ))}
          <a class="json" href={`/api/${entry.slug}.json`} aria-label={t("country.json", { country })}>
            JSON
          </a>
        </nav>
        <p class="muted">
          {t(`tab.${tab}.note`, { n: Math.round(config.ranking.min_public_share * 100) })} {t("country.inList")} <a href={href("/badge/")}>{t("country.addBadge")}</a>
        </p>
        <RankingTable rows={data.tabs[tab]} breakdown={data.breakdown} tab={tab} more={more} />
      </>
    ) : (
      <p class="empty">{t("country.collecting")}</p>
    )
  }
</Base>

<style>
  .tabs {
    display: flex;
    gap: 4px;
    margin: 20px 0 8px;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
  }
  .tabs a {
    padding: 8px 12px;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    white-space: nowrap;
  }
  .tabs a:hover {
    text-decoration: none;
    color: var(--fg);
  }
  .tabs a[aria-current="page"] {
    border-color: var(--accent);
    color: var(--fg);
    font-weight: 600;
  }
  /* The JSON link sits at the right end of the tab bar, apart from the tabs. */
  .tabs .json {
    margin-left: auto;
    align-self: center;
    padding: 0 0 0 12px;
    border: 0;
    font-size: 12px;
    color: var(--muted);
  }
  .tabs .json:hover {
    color: var(--fg);
    text-decoration: underline;
  }
  /* Separators come from CSS, so template whitespace can never shift them. */
  .meta > * + *::before {
    content: "·";
    color: var(--muted);
    padding: 0 6px;
  }
  .short {
    display: none;
  }
  @media (max-width: 560px) {
    .tabs a {
      padding: 8px;
    }
    .long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .short {
      display: inline;
    }
  }
  .empty {
    padding: 32px 0;
    color: var(--muted);
  }
</style>
