---
import Base from "../layouts/Base.astro";
import { countryEntries } from "../lib/site.ts";

// Badge links point here: /find/?login=…&tab=… opens that person's row in their best country ranking,
// or, with tab=world, in the world ranking.
const slugs = Object.fromEntries(countryEntries.map((c) => [c.title, c.slug]));
---

<Base title="Find a developer" noindex>
  <h1>Find a developer</h1>
  <p id="status" class="muted" data-slugs={JSON.stringify(slugs)}>Looking up…</p>

  <script>
    // Runs on the first load and after every client-side navigation (the page is swapped, not reloaded).
    function init(): void {
      // Ranking → badge file suffix and page path; nothing outside these values ever reaches a URL.
      // "world" has one page, so its badge file is only checked for existence, never parsed for a country.
      const TABS: Record<string, { suffix: string; path: string; world?: true }> = {
        public: { suffix: "", path: "" },
        all: { suffix: ".all", path: "all/" },
        commits: { suffix: ".commits", path: "commits/" },
        world: { suffix: ".world", path: "", world: true },
      };
      const status = document.getElementById("status");
      if (status) {
        const notFound = () => {
          status.textContent = "This developer is not in this ranking yet. ";
          const link = document.createElement("a");
          link.href = "/methodology/";
          link.textContent = "See who is considered.";
          status.append(link);
        };
        let slugs: Record<string, string> = {};
        try {
          slugs = JSON.parse(status.dataset["slugs"] ?? "{}");
        } catch {}
        const params = new URLSearchParams(location.search);
        const login = params.get("login") ?? "";
        const tab = TABS[params.get("tab") ?? "public"] ?? TABS["public"];
        // Same rule as GitHub logins.
        if (!tab || !/^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$/.test(login)) {
          notFound();
        } else {
          const name = login.toLowerCase();
          fetch(`/u/${name}${tab.suffix}.json`)
            .then((res) => (res.ok ? res.json() : null))
            .then((badge: { message?: unknown } | null) => {
              // "World: unranked (…)" and "Atlantis: unranked (…)" are files too, but not a rank.
              const rankedBadge = /^#\d+ /.test(String(badge?.message ?? ""));
              if (tab.world) {
                if (rankedBadge) location.replace(`/world/#${name}`);
                else notFound();
                return;
              }
              // "#17 Atlantis (public contributions)" → "Atlantis"
              const title = String(badge?.message ?? "").replace(/^#\d+\s+(.+?)\s+\([^()]*\)$/, "$1");
              const slug = slugs[title];
              // Slugs come from validated presets (^[a-z][a-z0-9_]+$), so this stays a same-site path.
              if (slug && /^[a-z][a-z0-9_]{1,40}$/.test(slug)) location.replace(`/${slug}/${tab.path}#${name}`);
              else notFound();
            })
            .catch(notFound);
        }
      }
    }
    document.addEventListener("astro:page-load", init);
  </script>
</Base>
