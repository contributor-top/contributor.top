---
import RankingTable from "../components/RankingTable.astro";
import Base from "../layouts/Base.astro";
import { worldNames, worldRows } from "../lib/site.ts";

const rows = worldRows();
const names = worldNames();
---

<Base
  title="Most active GitHub users in the world"
  description="The most active GitHub users worldwide, merged from every country ranking by public contributions over the last 12 months."
>
  <div class="head">
    <h1>World</h1>
    {
      rows.length > 0 && (
        <a class="json" href="/api/world.json" aria-label="World ranking as JSON">
          JSON
        </a>
      )
    }
  </div>
  <p class="muted">
    Merged from all country rankings (public contributions). Only people whose location matches a country are
    included, so this is not an exhaustive world ranking, and accounts whose activity looks automated are left out. See the{" "}
    <a href="/methodology/">methodology</a>.
  </p>
  {rows.length > 0 ? <RankingTable rows={rows} names={names} /> : <p class="muted">No country data yet.</p>}
</Base>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .json {
    font-size: 12px;
    color: var(--muted);
  }
  .json:hover {
    color: var(--fg);
  }
</style>
