---
import RankingHead from "../components/RankingHead.astro";
import RankingTable from "../components/RankingTable.astro";
import { i18n, parts } from "../i18n/index.ts";
import Base from "../layouts/Base.astro";
import { rowsBase, worldNames, worldRows } from "../lib/site.ts";

const rows = worldRows();
const names = worldNames();
const { t, href } = i18n(Astro.currentLocale);
---

<Base title={t("world.title")} description={t("world.description")}>
  <RankingHead slot="head" count={rows.length} more={rowsBase("world")} />
  <div class="head">
    <h1>{t("world.h1")}</h1>
    {
      rows.length > 0 && (
        <a class="json" href="/api/world.json" aria-label={t("world.json")}>
          JSON
        </a>
      )
    }
  </div>
  <p class="muted">
    {
      parts(t("world.intro")).map((part) =>
        part === "{link}" ? <a href={href("/methodology/")}>{t("world.methodology")}</a> : part,
      )
    }
  </p>
  {
    rows.length > 0 ? (
      <RankingTable rows={rows} names={names} more={rowsBase("world")} />
    ) : (
      <p class="muted">{t("world.empty")}</p>
    )
  }
</Base>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .json {
    font-size: 12px;
    color: var(--muted);
  }
  .json:hover {
    color: var(--fg);
  }
</style>
