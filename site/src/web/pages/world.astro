---
import RankingHead from "../components/RankingHead.astro";
import RankingSummary from "../components/RankingSummary.astro";
import RankingTable from "../components/RankingTable.astro";
import { i18n, parts } from "../i18n/index.ts";
import Base from "../layouts/Base.astro";
import { countryByTitle, rowsBase, updates, worldRows } from "../lib/site.ts";

const rows = worldRows();
const { t, href, list, number, country } = i18n(Astro.currentLocale);
const title = t("world.title");
const description = t("world.description");
// Where the world ranking comes from: how many countries, and the three with the most people in it.
const perCountry = new Map<string, number>();
for (const r of rows) perCountry.set(r.country, (perCountry.get(r.country) ?? 0) + 1);
const most = [...perCountry].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "en")).slice(0, 3);
const origin =
  perCountry.size > 0
    ? t("summary.countries", {
        top: rows.length,
        n: perCountry.size,
        list: list(most.map(([title, n]) => `${country(countryByTitle(title))} (${number(n)})`)),
      })
    : undefined;
// As on a country page: Dataset for Google Dataset Search, ItemList for the page itself. Updated with the latest country.
const jsonLd =
  rows.length > 0
    ? {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Dataset",
            name: title,
            description,
            url: new URL(href("/world/"), Astro.site).href,
            dateModified: updates.at(-1),
            license: "https://opensource.org/license/mit",
            isAccessibleForFree: true,
            creator: { "@type": "Organization", name: "contributor.top", url: Astro.site?.href },
          },
          {
            "@type": "ItemList",
            name: title,
            numberOfItems: rows.length,
            itemListElement: rows.slice(0, 10).map((r) => ({
              "@type": "ListItem",
              position: r.rank,
              url: `https://github.com/${r.login}`,
              name: r.login,
            })),
          },
        ],
      }
    : undefined;
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <RankingHead slot="head" count={rows.length} more={rowsBase("world")} />
  <div class="head">
    <h1>{t("world.h1")}</h1>
    {
      rows.length > 0 && (
        <a class="json" href="/api/world.json" aria-label={t("world.json")}>
          JSON
        </a>
      )
    }
  </div>
  <p class="muted">
    {
      parts(t("world.intro")).map((part) =>
        part === "{link}" ? <a href={href("/methodology/")}>{t("world.methodology")}</a> : part,
      )
    }
  </p>
  {
    rows.length > 0 ? (
      <>
        <RankingSummary rows={rows} what={t("country.what.public")} extra={origin} />
        <RankingTable rows={rows} more={rowsBase("world")} />
      </>
    ) : (
      <p class="muted">{t("world.empty")}</p>
    )
  }
</Base>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .json {
    font-size: 12px;
    color: var(--muted);
  }
  .json:hover {
    color: var(--fg);
  }
</style>
