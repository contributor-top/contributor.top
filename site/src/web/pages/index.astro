---
import { i18n } from "../i18n/index.ts";
import Base from "../layouts/Base.astro";
import { collected, countryEntries } from "../lib/site.ts";

const { t, href, day, country, locale } = i18n(Astro.currentLocale);
const site = (path: string) => new URL(href(path), Astro.site).href;
// The list is sorted by the names in this language.
const entries = countryEntries
  .map((c) => ({ ...c, name: country(c) }))
  .sort((a, b) => a.name.localeCompare(b.name, locale));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "contributor.top",
      url: site("/"),
      description: t("site.description"),
    },
    {
      "@type": "ItemList",
      name: t("nav.countries"),
      itemListElement: collected.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: country(c),
        url: site(`/${c.slug}/`),
      })),
    },
  ],
};
---

<Base title={t("home.title")} jsonLd={jsonLd}>
  <h1>{t("home.h1")}</h1>
  <p class="muted">{t("home.intro")}</p>
  <ul class="countries">
    {
      entries.map((c) => (
        <li>
          <a href={href(`/${c.slug}/`)}>{c.name}</a>
          <span class="muted">{c.data ? day(c.data.updatedAt) : t("home.collecting")}</span>
        </li>
      ))
    }
  </ul>
  <p class="muted">
    <a href={href("/world/")}>{t("home.world")}</a> · {t("home.worldNote")}
  </p>
</Base>

<style>
  .countries {
    columns: 2;
    padding-left: 18px;
    margin: 24px 0;
  }
  .countries li {
    break-inside: avoid;
    padding: 2px 0;
  }
  .countries .muted {
    margin-left: 8px;
  }
  /* Same as logins in the tables: blue in light, plain text in dark; hover only underlines. */
  .countries a {
    color: var(--login);
  }
  @media (max-width: 560px) {
    .countries {
      columns: 1;
    }
  }
</style>
