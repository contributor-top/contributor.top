---
import { i18n } from "../i18n/index.ts";
import Base from "../layouts/Base.astro";
import { countryEntries } from "../lib/site.ts";

const { t, href, day, country, locale } = i18n(Astro.currentLocale);
const site = (path: string) => new URL(href(path), Astro.site).href;
// The list is sorted by the names in this language.
const entries = countryEntries
  .map((c) => ({ ...c, name: country(c) }))
  .sort((a, b) => a.name.localeCompare(b.name, locale));

// The site itself. The countries are plain links in the page already; listing them again here only made the most
// visited page heavier, and search engines show no list result for them.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "contributor.top",
  url: site("/"),
  description: t("site.description"),
};
---

<Base title={t("home.title")} jsonLd={jsonLd}>
  <h1>{t("home.h1")}</h1>
  <p class="muted">{t("home.intro")}</p>
  <ul class="countries">
    {
      entries.map((c) => (
        <li>
          <a href={href(`/${c.slug}/`)}>{c.name}</a>
          <span class="muted">
            {c.data ? <time datetime={c.data.updatedAt}>{day(c.data.updatedAt)}</time> : t("home.collecting")}
          </span>
        </li>
      ))
    }
  </ul>
  <p class="muted">
    <a href={href("/world/")}>{t("home.world")}</a> · {t("home.worldNote")}
  </p>
</Base>

<style>
  .countries {
    columns: 2;
    padding-left: 18px;
    margin: 24px 0;
  }
  .countries li {
    break-inside: avoid;
    padding: 2px 0;
  }
  .countries .muted {
    margin-left: 8px;
  }
  /* Same as logins in the tables: blue in light, plain text in dark; hover only underlines. */
  .countries a {
    color: var(--login);
  }
  @media (max-width: 560px) {
    .countries {
      columns: 1;
    }
  }
</style>
