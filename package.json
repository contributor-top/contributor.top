{
  "name": "contributors-top",
  "version": "0.0.0",
  "private": true,
  "description": "Most active GitHub users by country",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && tsx scripts/build-badges.ts",
    "preview": "astro preview",
    "lint": "biome ci .",
    "fix": "biome check --write . && prettier --write \"**/*.{yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{yml,yaml,md}\"",
    "typecheck": "tsc --noEmit && astro check",
    "knip": "knip",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate.ts",
    "schemas": "tsx scripts/schemas.ts",
    "privacy-check": "tsx scripts/privacy-check.ts",
    "supply-chain": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity && npm audit signatures",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run knip && npm run validate && npm test && npm run build && npm run privacy-check"
  },
  "dependencies": {
    "astro": "7.3.8",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "fast-check": "4.10.2",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "lockfile-lint": "5.1.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "undici": "8.12.3"
  }
}
